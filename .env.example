# IdeaKiller — environment variables
#
# You need ONE of the following keys. The route auto-detects which is set
# and prefers Anthropic when both are present.
#
# Get an Anthropic key:  https://console.anthropic.com/settings/keys
# Get an OpenAI key:     https://platform.openai.com/api-keys

ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
